---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---
<Base
  title={"Donate · NoCloudware"}
  description={"Support NoCloudware — voluntary donation via PayPal. No account required, credit/debit card accepted."}
  ogImage={"https://www.nocloudware.com/ncw_logo_cloudy.webp"}
  ogType="website"
>
  <div class="legacy-main">
  <div class="container">
    <section class="hero">
      <h1>Support NoCloudware</h1>
      <p style="max-width:560px;margin:0 auto 0.5rem;">NoCloudware is an independent project by <strong>Adrian Goodrich</strong>. If these tools are useful to you and you'd like to support their continued development, you can make a voluntary donation.</p>
      <p class="text-muted" style="font-size:0.85rem;margin-bottom:2rem;">No PayPal account required. Credit and debit cards accepted.</p>

      <div id="paypal-container-J4JHBUMSS5AKG" style="display:inline-block;min-width:200px;margin:1rem 0;"></div>

      <p class="text-muted" style="font-size:0.85rem;margin-top:1.5rem;">Thank you for your support. </p>
    </section>
  </div>
</div>
  <Fragment slot="scripts">
    <script is:inline src="https://www.paypal.com/sdk/js?client-id=BAA9fALCprRwc8WCyBWr8beUc0OTLQzi3E2GQrFtEtaAS8NkeRxI3j7EfE1vfY5LphZWnKYv-w13pXzpuY&components=hosted-buttons&disable-funding=venmo&currency=USD"></script>
    <script is:inline>
  function renderPaypal() {
    var el = document.getElementById('paypal-container-J4JHBUMSS5AKG');
    if (typeof paypal !== 'undefined' && el && !el.hasChildNodes()) {
      paypal.HostedButtons({ hostedButtonId: "J4JHBUMSS5AKG" }).render("#paypal-container-J4JHBUMSS5AKG");
    }
  }
  if (document.readyState === 'complete') { renderPaypal(); }
  else { window.addEventListener('load', renderPaypal); }
</script>
  </Fragment>

</Base>
