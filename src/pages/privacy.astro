---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---
<Base
  title={"Privacy · NoCloudware"}
  description={"NoCloudware Privacy Policy"}
  ogImage={"https://www.nocloudware.com/ncw_logo_cloudy.webp"}
  ogType="website"
>
  <div class="legacy-main">
  <div class="container">
    <section style="max-width:800px;margin:0 auto;padding:2rem 0;">
      <h1>Privacy Policy</h1>
      <p class="text-muted mb-2">Last updated: June 2026</p>

      <h2>1. Information we collect</h2>
      <p>NoCloudware does not collect, store or transmit any personal information. All our applications run 100% locally on your device.</p>

      <h2>2. Permissions and access</h2>
      <p>Our applications do not require special permissions or internet access to function. All processing happens on your machine.</p>

      <h2>3. Cookies and tracking</h2>
      <p>This website only uses essential cookies for its operation. We do not use third-party cookies or analytics services that track your behavior.</p>

      <h2>4. Downloads and usage</h2>
      <p>By downloading our software, you receive a license to use it personally. We do not sell your data or share information with third parties.</p>

      <h2>5. Changes to this policy</h2>
      <p>Any changes to this privacy policy will be posted on this page.</p>

      <h2>6. Contact</h2>
      <p>If you have questions about this privacy policy, contact: <a href="mailto:nocloudware@outlook.com">nocloudware@outlook.com</a></p>
    </section>
  </div>
</div>

</Base>
