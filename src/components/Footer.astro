---
import { products, href } from '../data/products';

const ICONS = {
  x: '<path d="M14.234 10.162 22.977 0h-2.072l-7.591 8.824L7.251 0H.258l9.168 13.343L.258 24H2.33l8.016-9.318L16.749 24h6.993zm-2.837 3.299-.929-1.329L3.076 1.56h3.182l5.965 8.532.929 1.329 7.754 11.09h-3.182z"/>',
  bluesky: '<path d="M5.202 2.857C7.954 4.922 10.913 9.11 12 11.358c1.087-2.247 4.046-6.436 6.798-8.501C20.783 1.366 24 .213 24 3.883c0 .732-.42 6.156-.667 7.037-.856 3.061-3.978 3.842-6.755 3.37 4.854.826 6.089 3.562 3.422 6.299-5.065 5.196-7.28-1.304-7.847-2.97-.104-.305-.152-.448-.153-.327 0-.121-.05.022-.153.327-.568 1.666-2.782 8.166-7.847 2.97-2.667-2.737-1.432-5.473 3.422-6.3-2.777.473-5.899-.308-6.755-3.369C.42 10.04 0 4.615 0 3.883c0-3.67 3.217-2.517 5.202-1.026"/>',
};

const social = [
  { handle: '@nocloudware.bsky.social', icon: 'bluesky', href: 'https://bsky.app/profile/nocloudware.bsky.social' },
  { handle: '@NoCloudware', icon: 'x', href: 'https://x.com/NoCloudware' },
];
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <img src="/ncw_logo_cloudy.webp" alt="" width="35" height="28" loading="lazy" />
        <p>Tools you license once or use free. No subscriptions.</p>
      </div>
      <nav class="footer-col" aria-label="Products">
        <h2>Products</h2>
        {products.map((p) => <a href={href(p.slug)}>{p.name}</a>)}
      </nav>
      <nav class="footer-col" aria-label="Company">
        <h2>Company</h2>
        <a href="/about.html">About</a>
        <a href="mailto:nocloudware@outlook.com">Contact</a>
        {social.map((s) => (
          <a href={s.href} rel="me noopener">
            <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" fill={s.icon === 'x' ? 'currentColor' : '#1185FE'} set:html={ICONS[s.icon]} />
            {s.handle}
          </a>
        ))}
      </nav>
      <nav class="footer-col" aria-label="Legal">
        <h2>Legal</h2>
        <a href="/privacy.html">Privacy</a>
        <a href="/terms.html">Terms</a>
      </nav>
      <nav class="footer-col" aria-label="Support">
        <h2>Support</h2>
        <a href="/donate.html">Donate</a>
      </nav>
    </div>
    <p class="footer-bottom">© 2026 NoCloudware. An independent project by Adrian Goodrich.</p>
  </div>
</footer>
